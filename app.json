{
  "expo": {
    "name": "SUMS",
    "slug": "silverdab-ums",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "scheme": "silverdabums",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/favicon.png",
      "bundleIdentifier": "com.hpatenio.silverdabums"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logo_padded_square.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hpatenio.silverdabums",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/favicon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f98cf282-56fe-40e3-9133-5ff96fa4a3fd"
      }
    },
    "owner": "hpatenio"
  }
}
